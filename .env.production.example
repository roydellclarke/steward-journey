# StewardPath production config for the BACKEND container.
#
# Copy to .env.production (gitignored) and fill in the secrets, then pass it to
# the container at run time:  docker run --env-file .env.production ...
# Secrets are injected at RUN time, never baked into the image.
#
# The FRONTEND image needs no runtime env: its two NEXT_PUBLIC_* values are
# compiled in at BUILD time (see scripts/build-and-push-ghcr.sh).

# --- Public identity --------------------------------------------------------
# The exact origin of the deployed frontend. Used for CORS and the sign-in
# magic-link base. Must match the site the browser loads.
STEWARDPATH_FRONTEND_ORIGIN=https://stewardpathfinder.com

# --- Storage (MUST be a durable, backed-up volume) --------------------------
# Mount a persistent volume at this path (docker run -v stewardpath-data:/data/stewardpath).
STEWARDPATH_DATA_ROOT=/data/stewardpath
STEWARDPATH_AUTH_DB_PATH=/data/stewardpath/auth/auth.db

# --- Security (production posture) ------------------------------------------
# Generate a strong, unique secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot with secure cookies on the placeholder, by design.
STEWARDPATH_SECRET_KEY=
STEWARDPATH_COOKIE_SECURE=true
# Strong random token to reach ops endpoints (/orders, /leads). Unset = closed.
STEWARDPATH_ADMIN_TOKEN=

# --- Email (Resend) ---------------------------------------------------------
# Verify stewardpathfinder.com at resend.com/domains, then use an address on it
# so codes reach every owner (not just your Resend account email).
STEWARDPATH_RESEND_API_KEY=
STEWARDPATH_RESEND_FROM=StewardPath <no-reply@stewardpathfinder.com>
STEWARDPATH_LOG_AUTH_EMAILS=false

# --- Sign-in lifetimes ------------------------------------------------------
STEWARDPATH_OTP_TTL_MINUTES=10
# Magic link good for 14 days so "save and finish later" works.
STEWARDPATH_MAGIC_LINK_TTL_MINUTES=20160

# --- Stripe payments --------------------------------------------------------
STEWARDPATH_STRIPE_SECRET_KEY=
STEWARDPATH_STRIPE_WEBHOOK_SECRET=
STEWARDPATH_STRIPE_PRICE_REPORT=
STEWARDPATH_STRIPE_PRICE_CONCIERGE=
STEWARDPATH_STRIPE_PRICE_ADVISOR=

# --- LLM augmentation (optional) --------------------------------------------
# Deterministic-first; the app works without these. Enable to refine wording.
STEWARDPATH_USE_LLM=false
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
STEWARDPATH_KIMI_MODEL=moonshot/kimi-k2.6
STEWARDPATH_DEEPSEEK_MODEL=deepseek/deepseek-reasoner
