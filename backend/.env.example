# StewardPath backend configuration. Copy to .env and fill in.
# .env is gitignored. Never commit real secrets.

# --- Storage (MUST be a persistent, backed-up path in production) ----------
# Local dev often uses /tmp, which is wiped on reboot. In production point this
# at a durable volume and back it up.
STEWARDPATH_DATA_ROOT=/data/stewardpath
STEWARDPATH_AUTH_DB_PATH=/data/stewardpath/auth/auth.db

# --- Security (production) --------------------------------------------------
# Generate a strong, unique secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STEWARDPATH_SECRET_KEY=
# true in production (HTTPS required). The app refuses to boot with secure
# cookies on the placeholder secret, by design.
STEWARDPATH_COOKIE_SECURE=true
# The exact public origin of the frontend, e.g. https://app.yourdomain.com
STEWARDPATH_FRONTEND_ORIGIN=https://app.yourdomain.com
# Strong random token to reach ops endpoints (/orders, /leads). Unset = closed.
STEWARDPATH_ADMIN_TOKEN=
STEWARDPATH_OTP_TTL_MINUTES=10

# --- Email (required; owners cannot sign in without working delivery) ------
# Verify a domain at resend.com/domains, then set a from address on that domain.
# Without a verified domain, Resend test mode only delivers to your own account
# email, so real owners never receive a code.
STEWARDPATH_RESEND_API_KEY=
STEWARDPATH_RESEND_FROM=StewardPath <no-reply@yourdomain.com>
# Dev-only fallback: print the sign-in code to the server log. Keep false in prod.
STEWARDPATH_LOG_AUTH_EMAILS=false

# --- Stripe payments --------------------------------------------------------
# Live secret key (sk_live_...) in production; test key (sk_test_...) for staging.
STEWARDPATH_STRIPE_SECRET_KEY=
# From the webhook you register at dashboard.stripe.com (whsec_...). Required so
# payment confirmation and subscription cancellations are reliable.
STEWARDPATH_STRIPE_WEBHOOK_SECRET=
# Optional: pre-created Price IDs. Leave blank to price inline from the catalog.
STEWARDPATH_STRIPE_PRICE_REPORT=
STEWARDPATH_STRIPE_PRICE_CONCIERGE=
STEWARDPATH_STRIPE_PRICE_ADVISOR=
