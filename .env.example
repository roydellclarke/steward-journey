# StewardPath standalone services
STEWARDPATH_USE_LLM=false
STEWARDPATH_DATA_ROOT=backend/data/stewardpath
STEWARDPATH_LLM_TIMEOUT_SECONDS=120

# Optional Kimi + DeepSeek augmentation
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
STEWARDPATH_KIMI_MODEL=moonshot/kimi-k2.5
STEWARDPATH_DEEPSEEK_MODEL=deepseek/deepseek-reasoner
STEWARDPATH_KIMI_TEMPERATURE=1
STEWARDPATH_DEEPSEEK_TEMPERATURE=0.15

# Passwordless email auth (the two intake gates)
# Sign all sessions and magic links. Generate a strong value for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STEWARDPATH_SECRET_KEY=
# Exact origin the browser loads the frontend from. Used for CORS (credentials
# require a named origin, not "*") and as the base for magic-link URLs.
STEWARDPATH_FRONTEND_ORIGIN=http://localhost:3000
# Where the auth SQLite database lives. Defaults under STEWARDPATH_DATA_ROOT/auth.
STEWARDPATH_AUTH_DB_PATH=
# How long a one-time code / magic link stays valid, in minutes.
STEWARDPATH_OTP_TTL_MINUTES=10
# Set true in production (HTTPS). Lets the session cookie use SameSite=None +
# Secure for cross-site use. Leave false for local http dev.
STEWARDPATH_COOKIE_SECURE=false
# Postmark transactional email. Without both, sign-in emails are recorded
# in memory only (fine for local dev and tests, nothing is sent).
STEWARDPATH_POSTMARK_TOKEN=
STEWARDPATH_POSTMARK_FROM=
# Ops-only token for GET /leads (lists captured contacts). Leave empty to keep
# that endpoint disabled. When set, send it as the X-Admin-Token header.
STEWARDPATH_ADMIN_TOKEN=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
